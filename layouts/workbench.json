{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.13"
  },
  "type": "row",
  "link_handlers": [
    "file-browser"
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "worktree-support"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "space-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "sidebar-footer"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 64,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs-graph"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 0,
                  "gap": 0,
                  "lone": false,
                  "focus": {
                    "width": 1,
                    "color": "#268bd2"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "header": {
                    "content": {
                      "mod": "side-header",
                      "props": {
                        "stack": "panel-body"
                      }
                    },
                    "height": 42
                  },
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "file-browser"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 0,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "usage-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    },
    {
      "id": "fleet",
      "type": "block",
      "content": {
        "mod": "fleet-board"
      },
      "size": {
        "px": 400
      },
      "min": 320,
      "max": 720,
      "hidden": true
    },
    {
      "id": "prs",
      "type": "block",
      "content": {
        "mod": "pr-board"
      },
      "size": {
        "px": 400
      },
      "min": 320,
      "max": 720,
      "hidden": true
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
