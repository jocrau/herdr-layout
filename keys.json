{
  "global": {
    "cmd-b": "layout.toggle:sidebar",
    "cmd-shift-g": "mod.open:git-graph",
    "cmd-n": "mod.open:new-space",
    "cmd-shift-o": "mod.open:file-browser",
    "cmd-alt-o": "layout.toggle:panel",
    "cmd-shift-b": "mod.open:beads",
    "cmd-shift-f": "mod.open:summon-fleet",
    "cmd-alt-f": "mod.open:fleet-board",
    "cmd-shift-r": "mod.open:summon-prs",
    "cmd-alt-r": "mod.open:pr-board",
    "alt-tab": "mod.open:recent-panes",
    "cmd-.": "mod.open:zen"
  },
  "mod:recent-panes": {
    "alt-tab": "recent-panes.next",
    "alt-shift-tab": "recent-panes.prev"
  },
  "mod:pr-board": {
    "cmd-shift-r": "layout.hide:prs",
    "cmd-alt-left": "pr-board.leave"
  },
  "mod:fleet-board": {
    "cmd-shift-f": "layout.hide:fleet",
    "cmd-left": "fleet-board.prev-run",
    "cmd-right": "fleet-board.next-run",
    "cmd-alt-left": "fleet-board.leave"
  },
  "mod:git-graph": {
    "cmd-up": "git-graph.prev-pr",
    "cmd-down": "git-graph.next-pr"
  },
  "mod:file-browser": {
    "cmd-alt-left": "file-browser.leave"
  }
}
