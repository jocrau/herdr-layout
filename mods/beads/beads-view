def row_of(bead_id, state):
    """The bead's position in the view (1-based, as fzf's pos() counts), or None."""
    for i, line in enumerate(render(state).splitlines(), 1):
        if line.split("\t", 1)[0] == bead_id:
            return i
    return None


def reveal(bead_id, state):
    """Change the view as little as needed for the bead to show: unfold its ancestors,
    then leave a focus it isn't under, then show closed beads, then drop the label filter."""
    # Ancestors by bd's parent links (a child's id needn't extend its parent's), and by dot prefixes too.
    ancestors = {bead_id.rsplit(".", n)[0] for n in range(1, bead_id.count(".") + 1)}
    parents = {i["id"]: i.get("parent") for i in fetch(dict(state, stack=[], all=True, filter=[]))[1]}
    at, hops = parents.get(bead_id), 0
    while at and at not in ancestors and hops < 50:
        ancestors.add(at)
        at, hops = parents.get(at), hops + 1
    trial = json.loads(json.dumps(state))  # tried on a copy: the view changes only if the bead is found
    steps = [
        lambda: trial.update(collapsed=[b for b in trial["collapsed"] if b not in ancestors]),
        lambda: trial.update(stack=[]),
        lambda: trial.update(all=True),
        lambda: trial.update(filter=[]),
    ]
    pos = row_of(bead_id, trial)
    for step in steps:
        if pos:
            break
        step()
        pos = row_of(bead_id, trial)
    if pos and trial != state:
        state.clear()
        state.update(trial)
        save(state)
    return pos


def click(bead_id, token):
    """A click on the selected bead (see view): once a double-click can no longer
    follow, and if neither one nor a move came since, focus the bead."""
    import urllib.request
    time.sleep(CLICK_WAIT)
    try:
        with open(CLICK_FILE, encoding="utf-8") as f:
            if f.read() != token:
                return
    except OSError:
        return
    reload = f"transform-header({RUN} header)+reload({RUN} render)"
    action = f"execute-silent({RUN} focus {bead_id})+{reload}+first"
    try:
        urllib.request.urlopen(urllib.request.Request(
            f"http://127.0.0.1:{os.environ['FZF_PORT']}", data=action.encode(), method="POST"), timeout=2)
    except Exception:
        pass


def goto(pos):
    """Once fzf has its rows (it listens on FZF_PORT), select row `pos` and show its details."""
    import urllib.request
    url = f"http://127.0.0.1:{os.environ['FZF_PORT']}"
    for _ in range(200):
        time.sleep(0.05)
        try:
            if json.loads(urllib.request.urlopen(url, timeout=1).read()).get("totalCount", 0) >= pos:
                urllib.request.urlopen(urllib.request.Request(url, data=f"pos({pos})+show-preview".encode(), method="POST"), timeout=2)
                return
        except Exception:
            continue


def view(select=None):
    # The header changes before the (asynchronous) reload; after it, fzf drops it.
    reload = f"transform-header({RUN} header)+reload({RUN} render)"
    # Edit in the detail pane: shown first (Ctrl-E with it hidden), so fzf
    # passes its place to the editor.
    edit = f"show-preview+execute({RUN} edit {{1}})+reload({RUN} render)"
    close = f"execute({RUN} close {{1}})+reload({RUN} render)"
    click = shlex.quote(CLICK_FILE)
    os.makedirs(CACHE_DIR, exist_ok=True)
    args = [
        FZF, "--with-shell=sh -c", "--ansi", "--layout=reverse", "--no-sort", "--track",
        # Exact words, not fuzzy: scattered letters matched nearly every bead.
        # Every word must appear (any order); 'word is fuzzy, ^word / word$ anchor, !word excludes.
        "--exact",
        "--delimiter=\t", "--with-nth=5..", "--id-nth=1", "--listen",
        "--no-separator", "--no-scrollbar", "--gutter= ", "--info=hidden", "--prompt=› ",
        "--footer-border=none", "--ellipsis=…",
        # Starts in navigate mode (input hidden): letters are keys, as in the file and git
        # viewers; / shows the filter, esc hides it again (and quits from navigate mode).
        "--no-input",
        "--footer=j k move · l → in · h ← out · ⏎ ⇥ space details · ⌫ close · / filter · f labels · s sync · ? help · esc quit",
        # The cached pane when there is one (instant), else bd (and cache it).
        f"--preview=cat {shlex.quote(DETAIL_DIR)}/{{1}}@{{2}}@$FZF_PREVIEW_COLUMNS 2>/dev/null || {RUN} show {{1}} {{2}}",
        "--preview-window=right,50%,wrap-word,border-left,noinfo,hidden",
        "--preview-wrap-sign=",
        f"--bind=start:execute-silent({RUN} watch >/dev/null 2>&1 &)+transform-header({RUN} header)"
        + (f"+execute-silent({RUN} goto {select} >/dev/null 2>&1 &)" if select else ""),
        "--bind=enter:toggle-preview",
        "--bind=tab:toggle-preview",
        "--bind=ctrl-d:half-page-down,ctrl-u:half-page-up,home:first,end:last",
        # After every reload (asynchronous): the pane for the row now there, as
        # --track keeps a bead whose stamp (and so its pane) may have changed.
        "--bind=load:refresh-preview",
        # A click selects a bead; a click on the selected one opens its subtree, once
        # fzf's double-click window has passed (a double-click starts with two clicks):
        # the click leaves a token, which a focus change or a double-click clears.
        f"--bind=left-click:execute-silent([ {{4}} = 0 ] || {{ printf %s $$ > {click}; {RUN} click {{1}} $$ >/dev/null 2>&1 & }})",
        f"--bind=focus:execute-silent(: > {click})",
        f"--bind=double-click:execute-silent(: > {click})+toggle-preview",  # like ⏎
        # Delete (⌫, the Mac's Delete key, or ⌦) closes the bead after a y/n, while the filter is
        # hidden; with it showing, the keys edit it, and ⌫ on an empty filter goes up, as before.
        f'--bind=bspace:transform:if [ "$FZF_INPUT_STATE" = hidden ]; then echo "{close}"; '
        f'elif [ -z {{q}} ]; then echo "execute-silent({RUN} up)+{reload}"; else echo backward-delete-char; fi',
        f'--bind=del:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo "{close}" || echo delete-char',
        f"--bind=ctrl-a:execute-silent({RUN} all)+{reload}",
        f"--bind=ctrl-l:execute({RUN} labels {{1}})+reload({RUN} render)",
        f"--bind=ctrl-e:{edit}",
        # Esc: hide the filter (clearing it), else quit.
        '--bind=esc:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo abort || echo "clear-query+hide-input"',
    ]
    # Navigate mode (input hidden) gives letters their keys; with the filter showing they type.
    def nav(key, action):
        typed = "put( )" if key == "space" else f"put({key})"
        args.append(f'--bind={key}:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo "{action}" || echo "{typed}"')
    for key, action in (("j", "down"), ("k", "up"), ("g", "first"), ("G", "last"),
                        ("J", "down+show-preview"), ("K", "up+show-preview"),
                        ("space", "toggle-preview"), ("/", "show-input"), ("q", "abort"),
                        ("f", f"execute({RUN} filter)+{reload}"),
                        ("F", f"execute-silent({RUN} unfilter)+{reload}"),
                        ("s", f"execute({RUN} sync)+{reload}"),
                        ("?", f"execute({RUN} help | less -R)")):
        nav(key, action)
    # While the filter is empty, arrows walk the tree: Right edits the bead while
    # its details show (fzf sets the preview size only then), else focuses a
    # bead with children ({4}) or shows a leaf's details; Left jumps to the parent row
    # ({3}), and from a top row leaves the focus (--track keeps the cursor on
    # the bead just left, so the next Left goes on to its parent). With a
    # filter they move the cursor in it. Digits fold to a level, or are typed
    # (so `12` still finds `.12`). transform: form, as the actions have parentheses.
    # A folded bead ({4} = 2) unfolds first, as → opens a closed folder in the file viewer.
    right = (f'elif [ {{4}} = 2 ]; then echo "execute-silent({RUN} toggle {{1}})+reload({RUN} render)"; '
             f'elif [ -n "$FZF_PREVIEW_COLUMNS" ]; then echo "{edit}"; '
             f'elif [ {{4}} = 1 ]; then echo "execute-silent({RUN} focus {{1}})+{reload}+first"; '
             f'else echo show-preview; fi')
    # An open bead ({4} = 1) folds first, as ← closes an open folder in the file viewer.
    left = (f'elif [ {{4}} = 1 ]; then echo "execute-silent({RUN} toggle {{1}})+reload({RUN} render)"; '
            f'elif [ -n {{3}} ]; then printf "pos(%s)" {{3}}; '
            f'else echo "execute-silent({RUN} up)+{reload}"; fi')
    args.append(f'--bind=l:transform:if [ "$FZF_INPUT_STATE" != hidden ]; then echo "put(l)"; {right}')
    args.append(f'--bind=h:transform:if [ "$FZF_INPUT_STATE" != hidden ]; then echo "put(h)"; {left}')
    args.append(f'--bind=right:transform:if [ -n {{q}} ]; then echo forward-char; {right}')
    args.append(f'--bind=left:transform:if [ -n {{q}} ]; then echo backward-char; {left}')
    for n in range(10):
        args.append(f'--bind={n}:transform:[ "$FZF_INPUT_STATE" = hidden ] && echo "execute-silent({RUN} level {n})'
                    f'+reload({RUN} render)" || echo "put({n})"')
    proc = subprocess.run(args, input=render(load(), fresh=True), text=True, cwd=ROOT)
    sys.exit(0 if proc.returncode in (0, 1, 130) else proc.returncode)


def main(argv):
    missing = [name for name, path in (("bd", BD), ("fzf", FZF)) if not path]
    if missing:
        sys.exit(f"beads-view: needs {' and '.join(missing)} on PATH")
    if not argv:
        return view()
    cmd, rest = argv[0], argv[1:]
    state = load()
    if cmd == "--select" and rest:  # start on a bead (the fleet board's "in beads")
        return view(select=reveal(rest[0], state))
    if cmd == "goto" and rest and rest[0].isdigit():
        return goto(int(rest[0]))
    if cmd == "render":
        print(render(state))
    elif cmd == "header":
        print(header(state))
    elif cmd == "help":
        print(HELP)
    elif cmd == "show":  # no ID: the placeholder row, nothing to show
        if rest and rest[0]:
            sys.stdout.write(cached_detail(rest[0], rest[1] if len(rest) > 1 else ""))
    elif cmd == "toggle" and rest and rest[0]:
        state["collapsed"] = sorted(set(state["collapsed"]) ^ {rest[0]})
        save(state)
    elif cmd == "level" and rest and rest[0].isdigit():
        # Show N levels of the current view (level 1 = its top rows): fold every
        # bead at level N or deeper that has children; 0 unfolds the view.
        # Folds of beads outside the view are kept.
        n, rows = int(rest[0]), [row[:3] for row in visible(state)]
        in_view = {bead_id for _, bead_id, _ in rows}
        parents = {rows[i][1] for i in range(len(rows) - 1) if rows[i + 1][0] > rows[i][0]}
        folded = {bead_id for depth, bead_id, _ in rows if n and depth >= n - 1 and bead_id in parents}
        state["collapsed"] = sorted((set(state["collapsed"]) - in_view) | folded)
        save(state)
    elif cmd == "focus" and rest:
        # Only a bead with children becomes the view; a leaf (or an empty
        # list's blank row) would leave an empty screen.
        if not rest[0] or not has_children(rest[0], state):
            return
        if not state["stack"] or state["stack"][-1] != rest[0]:
            state["stack"].append(rest[0])
        # A focused bead shows its children, even if it was folded.
        state["collapsed"] = [b for b in state["collapsed"] if b != rest[0]]
        save(state)
    elif cmd == "up":
        if state["stack"]:
            state["stack"].pop()
        save(state)
    elif cmd == "all":
        state["all"] = not state["all"]
        save(state)
    elif cmd == "filter":
        if rest:  # beads-view filter owner:bob P1 (none: clear)
            state["filter"] = [t for t in rest if t]
            save(state)
        else:
            pick_filter(state)
    elif cmd == "unfilter":
        state["filter"] = []
        save(state)
    elif cmd in ("labels", "edit", "close"):
        if rest and rest[0]:  # empty while fzf's list (re)loads: nothing to edit
            {"labels": edit_labels, "edit": edit, "close": close_bead}[cmd](rest[0], state)
    elif cmd == "sync":
        sync_beads(state)
    elif cmd == "click" and len(rest) == 2 and rest[0]:
        click(rest[0], rest[1])
    elif cmd == "watch":
        watch()
    else:
        sys.exit(f"beads-view: unknown command {cmd!r}")


if __name__ == "__main__":
    main(sys.argv[1:])
